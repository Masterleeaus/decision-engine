{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://decision/evidence/1.0.0",
  "title": "Titan Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "contract_version",
    "company_id",
    "subject",
    "evidence_class",
    "claim",
    "value",
    "source",
    "acquisition",
    "confidence",
    "freshness",
    "integrity",
    "governance",
    "created_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_key"
      ],
      "properties": {
        "subject_type": {
          "type": "string",
          "minLength": 1
        },
        "subject_key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_class": {
      "enum": [
        "raw",
        "derived"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "claim_type"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "fact",
            "state",
            "signal",
            "measurement",
            "event",
            "relationship",
            "estimate",
            "classification",
            "inference"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "value": {},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_id",
        "observed_at",
        "retrieved_at",
        "trust_class"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "browser",
            "system",
            "provider",
            "sensor",
            "document",
            "user",
            "model",
            "derived"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "trust_class": {
          "enum": [
            "authenticated",
            "verified",
            "contextual",
            "untrusted",
            "derived"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "adapter",
        "rule_or_parser",
        "raw_capture_preserved"
      ],
      "properties": {
        "method": {
          "enum": [
            "direct_field",
            "structured_extract",
            "dom_extract",
            "api_read",
            "system_read",
            "sensor_read",
            "document_extract",
            "user_assertion",
            "transform"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "rule_or_parser": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_capture_preserved": {
          "type": "boolean"
        },
        "capture_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "level",
        "basis",
        "limitations"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "as_of",
        "max_age_seconds",
        "age_seconds"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "expired",
            "unknown"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "max_age_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "age_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "derivation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "transform_id",
        "transform_version",
        "parent_evidence_ids",
        "assumptions"
      ],
      "properties": {
        "transform_id": {
          "type": "string",
          "minLength": 1
        },
        "transform_version": {
          "type": "string",
          "minLength": 1
        },
        "parent_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula_or_method": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "canonicalization"
      ],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalization": {
          "const": "titan-evidence-v1"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_bearing",
        "sensitivity",
        "allowed_purposes",
        "retention_class"
      ],
      "properties": {
        "authority_bearing": {
          "const": false
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "understanding",
              "comparison",
              "prediction",
              "ranking",
              "recommendation",
              "monitoring",
              "execution_preparation",
              "audit"
            ]
          }
        },
        "retention_class": {
          "enum": [
            "ephemeral",
            "standard",
            "evidence_record",
            "regulated"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extension_data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "raw"
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": {
            "const": "derived"
          }
        }
      },
      "then": {
        "required": [
          "derivation"
        ],
        "properties": {
          "derivation": {
            "type": "object"
          }
        }
      }
    }
  ]
}
