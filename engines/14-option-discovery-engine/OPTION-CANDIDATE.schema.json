{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/option-candidate-1.0.0.json",
  "title": "Titan OptionCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "option_id",
    "contract_version",
    "company_id",
    "decision_subject_id",
    "kind",
    "title",
    "intent",
    "source",
    "provenance",
    "feasibility",
    "confidence",
    "created_at"
  ],
  "properties": {
    "option_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "action",
        "resource",
        "supplier",
        "assignment",
        "intervention",
        "schedule",
        "strategy",
        "tool",
        "resolution"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "target_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "source": {
      "enum": [
        "internal_catalog",
        "provider",
        "knowledge",
        "historical",
        "generated",
        "policy",
        "browser_context",
        "system_context"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider_id",
          "source_id"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "discovery_rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "hard_failures",
        "soft_constraints",
        "unknowns"
      ],
      "properties": {
        "state": {
          "enum": [
            "eligible",
            "ineligible",
            "unknown"
          ]
        },
        "hard_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "soft_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraint_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extension_data": {
      "type": "object"
    }
  }
}
