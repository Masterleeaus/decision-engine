{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/observation/1.0.0",
  "title": "Titan Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "contract_version",
    "company_id",
    "kind",
    "subject",
    "source",
    "observed_at",
    "evidence",
    "confidence",
    "lifecycle"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "entity",
        "state",
        "signal",
        "opportunity",
        "problem",
        "decision_subject"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "decision_relevance": {
      "$ref": "#/$defs/decisionRelevance"
    },
    "extension_data": {
      "type": "object",
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_key",
        "label"
      ],
      "properties": {
        "subject_type": {
          "type": "string",
          "minLength": 1
        },
        "subject_key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "external_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_id",
        "trust_class"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "browser",
            "system",
            "provider",
            "user",
            "sensor",
            "derived"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_class": {
          "type": "string",
          "enum": [
            "untrusted",
            "contextual",
            "authenticated",
            "authoritative_for_fact"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "provider_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "field",
        "value",
        "provenance"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "raw",
            "normalized",
            "derived"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_key"
      ],
      "properties": {
        "relation_type": {
          "type": "string",
          "minLength": 1
        },
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "level",
        "basis"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "revision"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "retracted",
            "expired"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_observation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "decisionRelevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_evaluation"
      ],
      "properties": {
        "requires_evaluation": {
          "type": "boolean"
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "urgency": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "candidate_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
