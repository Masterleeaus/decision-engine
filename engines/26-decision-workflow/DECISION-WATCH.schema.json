{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/decision-watch/1.0.0",
  "title": "Decision Watch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "watch_id",
    "company_id",
    "decision_subject_id",
    "status",
    "condition",
    "created_at"
  ],
  "properties": {
    "watch_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "closed"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "changed",
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "not_contains",
            "exists",
            "not_exists"
          ]
        },
        "expected": {},
        "max_age_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_triggered_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_evaluation_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "interval_seconds": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "cooldown_seconds": {
      "type": "number",
      "minimum": 0
    }
  }
}
