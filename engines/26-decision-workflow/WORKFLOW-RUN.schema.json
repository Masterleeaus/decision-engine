{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/decision-workflow/run/1.0.0",
  "title": "Decision Workflow Run Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "decision_subject_id",
    "decision_id",
    "run_id",
    "idempotency_key",
    "trigger",
    "input"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "enum": [
        "manual",
        "event",
        "scheduled",
        "watch"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    }
  }
}
