{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://decision/canonical-entity/1.0.0",
  "title": "Titan Canonical Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "contract_version",
    "company_id",
    "entity_type",
    "canonical_label",
    "identifiers",
    "aliases",
    "attributes",
    "source_records",
    "resolution",
    "lineage",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^ent_[0-9a-f]{24}$"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "person",
        "item",
        "asset",
        "supplier",
        "job",
        "company",
        "opportunity",
        "intervention",
        "resource",
        "customer",
        "worker",
        "location",
        "document",
        "other"
      ]
    },
    "canonical_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "value",
          "normalized_value",
          "strength",
          "source_id"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "normalized_value": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "enum": [
              "strong",
              "medium",
              "weak"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "normalized_alias",
          "source_id"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "normalized_alias": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attributes": {
      "type": "object"
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "source_id",
          "record_id",
          "observed_at"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "browser",
              "system",
              "provider",
              "database",
              "document",
              "user",
              "sensor",
              "derived"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confidence",
        "method",
        "match_evidence",
        "conflicts"
      ],
      "properties": {
        "state": {
          "enum": [
            "canonical",
            "provisional",
            "ambiguous",
            "conflicted",
            "split"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "enum": [
            "created",
            "strong_identifier",
            "weighted_match",
            "manual",
            "split",
            "imported"
          ]
        },
        "match_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merged_from",
        "split_from",
        "supersedes"
      ],
      "properties": {
        "merged_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "split_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extension_data": {
      "type": "object"
    }
  }
}
