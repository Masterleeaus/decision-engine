{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.example/schemas/provider-reliability.schema.json",
  "title": "Provider Reliability Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "company_id",
    "provider_id",
    "window_start",
    "window_end",
    "generated_at",
    "health",
    "sample_count",
    "success_count",
    "partial_count",
    "failure_count",
    "success_rate",
    "failure_rate",
    "stale_count",
    "mixed_freshness_count",
    "unknown_freshness_count",
    "stale_rate",
    "latency_p50_ms",
    "latency_p95_ms",
    "failure_class_counts",
    "authority_effect"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "window_start": { "type": "string", "format": "date-time" },
    "window_end": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "health": { "enum": ["healthy", "degraded", "unavailable", "insufficient_data"] },
    "sample_count": { "type": "integer", "minimum": 0 },
    "success_count": { "type": "integer", "minimum": 0 },
    "partial_count": { "type": "integer", "minimum": 0 },
    "failure_count": { "type": "integer", "minimum": 0 },
    "success_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "failure_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "stale_count": { "type": "integer", "minimum": 0 },
    "mixed_freshness_count": { "type": "integer", "minimum": 0 },
    "unknown_freshness_count": { "type": "integer", "minimum": 0 },
    "stale_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "latency_p50_ms": { "type": ["integer", "null"], "minimum": 0 },
    "latency_p95_ms": { "type": ["integer", "null"], "minimum": 0 },
    "failure_class_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "authority_effect": { "const": "none" }
  }
}
