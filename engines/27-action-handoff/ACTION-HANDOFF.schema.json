{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.example/schemas/action-handoff.schema.json",
  "title": "Decision Action Handoff Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "company_id",
    "decision_subject_id",
    "decision_id",
    "status",
    "reason_codes",
    "authority_effect"
  ],
  "properties": {
    "handoff_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "decision_subject_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["prepared", "approval_required", "abstained", "blocked", "review_required"]
    },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "prepared_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "company_id",
        "decision_subject_id",
        "decision_id",
        "option_id",
        "action_id",
        "capability_id",
        "capability_version",
        "actor_id",
        "parameters",
        "evidence_refs",
        "created_at",
        "expires_at",
        "host_assessment",
        "dispatch_state",
        "authority_effect"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "company_id": { "type": "string", "minLength": 1 },
        "decision_subject_id": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 },
        "option_id": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "capability_id": { "type": "string", "minLength": 1 },
        "capability_version": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string" },
        "parameters": { "type": "object" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "host_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorization", "policy_version", "assessed_at", "expires_at"],
          "properties": {
            "authorization": { "enum": ["allowed", "approval_required"] },
            "policy_version": { "type": "string", "minLength": 1 },
            "assessed_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        },
        "dispatch_state": { "const": "not_dispatched" },
        "authority_effect": { "const": "none" }
      }
    },
    "authority_effect": { "const": "none" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["prepared", "approval_required"] } } },
      "then": { "required": ["prepared_request"] },
      "else": { "not": { "required": ["prepared_request"] } }
    }
  ]
}
