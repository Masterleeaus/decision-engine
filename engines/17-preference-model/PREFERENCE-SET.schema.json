{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Preference Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preference_set_id",
    "contract_version",
    "company_id",
    "actor_id",
    "preferences",
    "created_at"
  ],
  "properties": {
    "preference_set_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    },
    "created_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preference_id",
        "scope",
        "key",
        "value",
        "strength",
        "source",
        "provenance",
        "authority_effect"
      ],
      "properties": {
        "preference_id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "company",
            "actor"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "enum": [
            "explicit",
            "inferred",
            "imported",
            "default"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "authority_effect": {
          "const": "none"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
