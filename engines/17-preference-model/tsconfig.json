{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "runtime/**/*.ts",
    "tests/**/*.ts",
    "validate*.ts",
    "node-shim.d.ts"
  ]
}
