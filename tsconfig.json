{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "index.ts",
    "node-shim.d.ts",
    "engines/*/runtime/**/*.ts"
  ]
}

